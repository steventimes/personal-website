---
interface Props {
  username: string;
}

const { username } = Astro.props;
---
<div data-repo-cards data-username={username}>
  <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
    <p class="max-w-2xl text-sm leading-6 text-zinc-600">
      Selected non-fork repositories, ordered by stars and recent activity.
    </p>
    <a class="text-link shrink-0 text-sm" href={`https://github.com/${username}`} target="_blank" rel="noreferrer">
      View all on GitHub
    </a>
  </div>

  <div data-repo-grid class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite">
    <p class="text-sm text-zinc-500">Loading public repositories...</p>
  </div>
  <p data-repo-error class="mt-4 hidden text-sm text-red-700" role="status"></p>
</div>

<script>
  import "../scripts/repo-cards";
</script>
