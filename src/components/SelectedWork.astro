---
import type { WorkItem } from "../data/site";

interface Props {
  items: WorkItem[];
}

const { items } = Astro.props;
---
<ol class="work-list">
  {items.map((item, index) => (
    <li>
      <article
        id={item.id}
        class:list={["work-item", { "work-item--featured": index === 0 }]}
      >
        <header class="work-item__heading">
          {index === 0 && <p class="work-item__status">Current research</p>}
          <h3>{item.title}</h3>
        </header>
        <dl class="work-item__details">
          <div>
            <dt>Question</dt>
            <dd>{item.context}</dd>
          </div>
          <div>
            <dt>Contribution</dt>
            <dd>{item.contribution}</dd>
          </div>
          <div>
            <dt>Methods</dt>
            <dd>{item.methods.join(" · ")}</dd>
          </div>
        </dl>
        {item.link && (
          <a href={item.link.href} target="_blank" rel="noreferrer">{item.link.label}</a>
        )}
      </article>
    </li>
  ))}
</ol>
