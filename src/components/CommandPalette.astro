---
import type { CommandItem } from "../lib/commands";

interface Props {
  items: CommandItem[];
}

const { items } = Astro.props;
---
<dialog
  id="command-palette"
  class="command-dialog surface"
  data-command-palette
  data-items={JSON.stringify(items)}
  aria-labelledby="command-title"
>
  <header class="flex items-center justify-between gap-4 p-4">
    <div>
      <h2 id="command-title" class="font-semibold text-zinc-950">Navigate</h2>
      <p class="mt-1 text-sm text-zinc-500">Search sections and external links.</p>
    </div>
    <button class="icon-button" type="button" data-command-close aria-label="Close" title="Close">×</button>
  </header>

  <div class="border-y border-zinc-200 p-3">
    <label class="sr-only" for="command-search">Search</label>
    <input
      id="command-search"
      data-command-input
      class="w-full rounded border border-zinc-300 bg-white px-3 py-2 text-base text-zinc-950 placeholder:text-zinc-400"
      type="search"
      placeholder="Search"
      autocomplete="off"
      spellcheck="false"
      aria-autocomplete="list"
      aria-controls="command-results"
      aria-expanded="false"
    />
  </div>

  <div
    id="command-results"
    data-command-list
    class="max-h-[55vh] overflow-auto p-2"
    role="listbox"
    aria-label="Search results"
  ></div>
  <p
    data-command-status
    class="sr-only"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
</dialog>

<script>
  import "../scripts/command-palette";
</script>
