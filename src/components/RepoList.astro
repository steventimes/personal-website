---
import type { RepositorySnapshot } from "../lib/repositories";

interface Props {
  username: string;
  repositories: RepositorySnapshot[];
}

const { username, repositories } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC"
});
const formatCount = (value: number, label: string) =>
  `${value} ${label}${value === 1 ? "" : "s"}`;
---
<div class="repo-list" data-repo-cards data-username={username}>
  <div class="repo-list__intro">
    <p>Public-repository snapshot, ordered by stars and recent activity.</p>
    <a href={`https://github.com/${username}`} target="_blank" rel="noreferrer">View all on GitHub</a>
  </div>

  <ol>
    {repositories.map((repository) => (
      <li>
        <article class="repo-row" data-repo-name={repository.name}>
          <div>
            <h3>
              <a href={repository.url} target="_blank" rel="noreferrer">{repository.name}</a>
            </h3>
            <p data-repo-description>{repository.description}</p>
          </div>
          <dl class="repo-row__metadata">
            <div>
              <dt>Language</dt>
              <dd data-repo-language>{repository.language}</dd>
            </div>
            <div>
              <dt>Stars</dt>
              <dd data-repo-stars={repository.stars}>{formatCount(repository.stars, "star")}</dd>
            </div>
            <div>
              <dt>Forks</dt>
              <dd data-repo-forks={repository.forks}>{formatCount(repository.forks, "fork")}</dd>
            </div>
            <div>
              <dt>Updated</dt>
              <dd>
                <time data-repo-updated datetime={repository.updatedAt}>
                  {dateFormatter.format(new Date(repository.updatedAt))}
                </time>
              </dd>
            </div>
          </dl>
        </article>
      </li>
    ))}
  </ol>

  <p class="mt-4 text-sm text-[var(--muted)]" data-repo-error role="status" hidden>
    Live GitHub data unavailable.
  </p>
</div>
