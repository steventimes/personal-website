---
import type { ExperienceItem, FeaturedExperience } from "../data/site";

interface Props {
  featured: FeaturedExperience;
  supporting: ExperienceItem[];
}

const { featured, supporting } = Astro.props;
---
<div class="experience-layout">
  <article class="experience-feature">
    <header class="experience-feature__heading">
      <div>
        <p class="section-kicker">Most recent internship</p>
        <h3>{featured.title}</h3>
      </div>
      <div class="experience-meta">
        <p>{featured.organization}</p>
        <p>{featured.time}</p>
      </div>
    </header>

    <p class="experience-feature__summary">{featured.summary}</p>
    <ul class="experience-feature__work">
      {featured.contributions.map((contribution) => <li>{contribution}</li>)}
    </ul>
    <p class="method-line"><span>Built with</span>{" "}{featured.technologies.join(" · ")}</p>
    <a class="text-link" href={featured.link.href} target="_blank" rel="noreferrer">
      {featured.link.label}<span aria-hidden="true"> ↗</span>
    </a>
  </article>

  <div class="supporting-experience">
    <p class="section-kicker">Additional experience</p>
    <ol class="experience-list">
      {supporting.map((item) => (
        <li>
          <article>
            <p class="experience-list__time">{item.time}</p>
            <h3>{item.title}</h3>
            <p class="experience-list__org">{item.organization}</p>
            <p>{item.summary}</p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</div>
