---
import type { Profile } from "../data/site";

interface Props {
  name: string;
  profile: Profile;
}

const { name, profile } = Astro.props;
---
<section id="about" class="hero" aria-labelledby="intro-title">
  <div class="hero__copy">
    <p class="hero__role">{profile.role}</p>
    <h1 id="intro-title">{name}</h1>
    <p class="hero__intro">{profile.intro}</p>

    <div class="hero__actions" aria-label="Primary links">
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={profile.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      <a href={profile.resumePath}>Résumé</a>
    </div>

    <dl class="hero__metadata" aria-label="Education summary">
      {profile.metadata.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <figure class="hero__portrait-frame">
    <img
      class="hero__portrait"
      src={profile.photoPath}
      alt={`${name} portrait`}
      width="640"
      height="480"
    />
  </figure>
</section>
