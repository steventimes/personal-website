---
import type { TimelineItem } from "../data/site";

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---
<ol class="timeline">
  {items.map((item) => (
    <li>
      <article class="timeline__item">
        <div class="timeline__metadata">
          <p>{item.org}</p>
          <p>
            {item.time}
            {item.time.includes("Present") && <span class="timeline__status">Current</span>}
          </p>
        </div>
        <div class="timeline__content">
          <h3>{item.title}</h3>
          <ul>
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </div>
      </article>
    </li>
  ))}
</ol>
