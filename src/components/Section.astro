---
interface Props {
  id: string;
  title: string;
  variant?: "default" | "band";
}

const { id, title, variant = "default" } = Astro.props;
---
<section id={id} class:list={["page-section", { "page-section--band": variant === "band" }]}>
  <div class="page-section__inner">
    <header class="page-section__header">
      <h2>{title}</h2>
    </header>
    <slot />
  </div>
</section>
