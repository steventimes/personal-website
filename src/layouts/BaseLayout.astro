---
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource/ibm-plex-mono";

const { title = "Home", description = "Personal site" } = Astro.props;
---
<!doctype html>
<html lang="en" class="no-js h-full font-sans">
  <head>
    <script is:inline>document.documentElement.classList.replace("no-js", "js");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="Xxi2JkYe_C8fTX8OTLJTWlYCFZwYayeir9onVxS-Weo" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="min-h-full antialiased">
    <div class="min-h-screen">
      <slot />
    </div>
  </body>
</html>
