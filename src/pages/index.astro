---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SkillPills from "../components/SkillPills.astro";
import Timeline from "../components/Timeline.astro";
import RepoCards from "../components/RepoCards.astro";
import CommandPalette from "../components/CommandPalette.astro";
import "../styles/global.css";
import { site } from "../data/site";
---

<BaseLayout title={`${site.name} | Personal Site`} description={site.tagline}>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="sticky top-0 z-40 border-b border-zinc-200 bg-white/95">
    <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5" aria-label="Primary navigation">
      <a href="#" class="font-semibold text-zinc-950">{site.name}</a>

      <div class="hidden items-center gap-5 text-sm text-zinc-600 md:flex">
        <a class="nav-link" href="#about">About</a>
        <a class="nav-link" href="#skills">Skills</a>
        <a class="nav-link" href="#experience">Experience</a>
        <a class="nav-link" href="#projects">Projects</a>
        <a class="nav-link" href="#repos">Repos</a>
        <a class="nav-link" href="#contact">Contact</a>
      </div>

      <button type="button" class="btn-outline px-3 py-1.5 text-sm" data-command-trigger>
        Search
      </button>
    </nav>
  </header>

  <main id="main-content">
    <section class="mx-auto max-w-5xl px-5 pb-12 pt-14 md:pb-16 md:pt-20">
      <div class="grid items-start gap-10 md:grid-cols-[minmax(0,1fr)_16rem] md:gap-16">
        <div>
          <p class="eyebrow">B.S. Computer Science · Mathematics minor · December 2026</p>
          <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-zinc-950 md:text-6xl">
            {site.name}
          </h1>
          <p class="mt-5 max-w-3xl text-xl leading-relaxed text-zinc-700 md:text-2xl">
            {site.tagline}
          </p>
          <p class="mt-6 max-w-2xl leading-7 text-zinc-600">
            {site.about[0]} I work across database research, backend engineering, and reproducible evaluation.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn-primary px-4 py-2 font-medium" href="#contact">Contact</a>
            <a class="btn-outline px-4 py-2" href={`https://github.com/${site.githubUsername}`} target="_blank" rel="noreferrer">GitHub</a>
            <a class="btn-outline px-4 py-2" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
            <a class="btn-outline px-4 py-2" href={site.resumePath} target="_blank" rel="noreferrer">Resume</a>
          </div>
        </div>

        <figure>
          <img
            src={site.photoPath}
            alt={`${site.name} headshot`}
            class="aspect-[4/5] w-full rounded-md border border-zinc-200 bg-white object-cover"
            width="640"
            height="800"
          />
          <figcaption class="mt-3 text-sm text-zinc-500">{site.location}</figcaption>
        </figure>
      </div>

      <dl class="mt-12 grid border-y border-zinc-200 sm:grid-cols-3">
        {site.highlights.map((item) => (
          <div class="py-4 sm:border-r sm:px-5 sm:first:pl-0 sm:last:border-r-0">
            <dt class="eyebrow">{item.label}</dt>
            <dd class="mt-1 text-sm font-medium leading-6 text-zinc-800">{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <Section id="about" title="About" kicker="Profile">
      <div class="grid gap-10 md:grid-cols-[minmax(0,1.4fr)_minmax(15rem,0.6fr)]">
        <div class="space-y-4 leading-7 text-zinc-700">
          {site.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <dl class="divide-y divide-zinc-200 border-y border-zinc-200 text-sm">
          <div class="grid grid-cols-[6rem_1fr] gap-3 py-3">
            <dt class="text-zinc-500">Location</dt>
            <dd class="font-medium text-zinc-900">{site.location}</dd>
          </div>
          <div class="grid grid-cols-[6rem_1fr] gap-3 py-3">
            <dt class="text-zinc-500">Current work</dt>
            <dd class="font-medium text-zinc-900">FluidLSM research and text-to-SQL evaluation</dd>
          </div>
          <div class="grid grid-cols-[6rem_1fr] gap-3 py-3">
            <dt class="text-zinc-500">Email</dt>
            <dd class="min-w-0 break-words font-medium text-zinc-900">
              <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
        </dl>
      </div>
    </Section>

    <Section id="skills" title="Skills" kicker="Technical range">
      <SkillPills skills={site.skills} />
    </Section>

    <Section id="experience" title="Experience" kicker="Work and research">
      <Timeline items={site.experience} />
    </Section>

    <Section id="projects" title="Selected Projects" kicker="Applied work">
      <div class="grid gap-5 md:grid-cols-2">
        {site.projects.map((project) => (
          <article class="surface shadow-soft flex h-full flex-col rounded-md p-5">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-lg font-semibold text-zinc-950">{project.name}</h3>
              {project.link && (
                <a class="text-link shrink-0 text-sm" href={project.link} target="_blank" rel="noreferrer">View</a>
              )}
            </div>
            <p class="mt-3 flex-1 leading-7 text-zinc-600">{project.desc}</p>
            <div class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
              {project.tech.map((technology) => <span class="tag">{technology}</span>)}
            </div>
          </article>
        ))}
      </div>
    </Section>

    <Section id="repos" title="GitHub Repositories" kicker="Public code">
      <RepoCards username={site.githubUsername} />
    </Section>

    <Section id="contact" title="Contact" kicker="Get in touch">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-center">
        <p class="max-w-2xl leading-7 text-zinc-700">
          For research, engineering, or collaboration inquiries, email me at
          <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary px-4 py-2 font-medium" href={`mailto:${site.email}`}>Email</a>
          <a class="btn-outline px-4 py-2" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="btn-outline px-4 py-2" href={`https://github.com/${site.githubUsername}`} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </Section>
  </main>

  <footer class="mx-auto max-w-5xl border-t border-zinc-200 px-5 py-8 text-sm text-zinc-500">
    Astro + TypeScript · GitHub Pages · © {new Date().getFullYear()} {site.name}
  </footer>

  <CommandPalette items={[
    { label: "About", href: "#about" },
    { label: "Skills", href: "#skills" },
    { label: "Experience", href: "#experience" },
    { label: "Projects", href: "#projects" },
    { label: "GitHub Repositories", href: "#repos" },
    { label: "Contact", href: "#contact" },
    { label: "LinkedIn", href: site.linkedin },
    { label: "GitHub", href: `https://github.com/${site.githubUsername}` },
    { label: "Email", href: `mailto:${site.email}` },
    { label: "Resume", href: site.resumePath }
  ]} />
</BaseLayout>
